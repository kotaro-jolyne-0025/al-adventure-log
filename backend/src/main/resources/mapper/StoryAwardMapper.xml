<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dndadvlog.backend.mapper.StoryAwardMapper">

    <resultMap id="awardMap" type="com.dndadvlog.backend.entity.StoryAward">
        <id     property="id"               column="id"/>
        <result property="adventureEntryId" column="adventure_entry_id"/>
        <result property="awardName"         column="award_name"/>
        <result property="description"      column="description"/>
        <result property="createdAt"        column="created_at"/>
        <result property="updatedAt"        column="updated_at"/>
    </resultMap>

    <select id="findByAdventureEntryId" resultMap="awardMap">
        SELECT * FROM adventure_story_award
        WHERE adventure_entry_id = #{adventureEntryId}::uuid
        ORDER BY created_at ASC
    </select>

    <select id="findByAdventureEntryIds" resultMap="awardMap">
        SELECT * FROM adventure_story_award
        WHERE adventure_entry_id IN
        <foreach collection="entryIds" item="entryId" open="(" separator="," close=")">
            #{entryId}::uuid
        </foreach>
        ORDER BY adventure_entry_id, created_at ASC
    </select>

    <select id="findById" resultMap="awardMap">
        SELECT * FROM adventure_story_award WHERE id = #{id}::uuid
    </select>

    <insert id="insert">
        INSERT INTO adventure_story_award (id, adventure_entry_id, award_name, description, created_at, updated_at)
        VALUES (#{id}::uuid, #{adventureEntryId}::uuid, #{awardName}, #{description}, NOW(), NOW())
    </insert>

    <update id="update">
        UPDATE adventure_story_award SET
            award_name  = #{awardName},
            description = #{description},
            updated_at  = NOW()
        WHERE id = #{id}::uuid
    </update>

    <delete id="deleteById">
        DELETE FROM adventure_story_award WHERE id = #{id}::uuid
    </delete>

    <delete id="deleteByAdventureEntryId">
        DELETE FROM adventure_story_award WHERE adventure_entry_id = #{adventureEntryId}::uuid
    </delete>

</mapper>
